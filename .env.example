# Flask session signing key. Generate a unique random value for each deployment.
SECRET_KEY=replace-with-a-long-random-secret

# Set true on HTTPS production hosting (for example Render); false for local HTTP.
SESSION_COOKIE_SECURE=false

# Optional live threat-intelligence integrations.
# Leave blank to use the offline ML model, local rules and local blocklists only.
# Google Safe Browsing API key: https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# URLhaus Auth-Key: https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# Password recovery email (required to deliver reset links).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Trusted HTTPS origin used to construct reset links; never derived from Host headers.
PUBLIC_APP_URL=https://your-phishguard-domain.example
