# PhishGuard online mode settings.
# Everything here is OPTIONAL. Leave a value blank (or delete the line) to keep the default.
# Online checks only run when "Online mode" is switched on in the dashboard
# and the computer has internet. Offline mode never makes a network request.

# --- Sources that need a free API key (each one receives the scanned URL) ---
# Google Safe Browsing API key: https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# URLhaus Auth-Key: https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# --- Sources that need NO key ---
# OpenPhish community feed: a public list of currently active phishing URLs,
# downloaded and compared locally (the scanned URL is not sent anywhere).
# Updated by OpenPhish about every 12 hours. NON-COMMERCIAL USE ONLY:
# https://openphish.com/terms.html
# Leave the line below as it is to use the default feed, or set another feed URL.
# To switch the feed off completely, uncomment the next line and leave it empty:
# OPENPHISH_FEED_URL=

# Domain age check (RDAP). Looks up when the domain was registered and sends only
# the domain name (for example example.com). Brand-new domains are suspicious.
# Set to false to turn it off.
ENABLE_DOMAIN_AGE_CHECK=true

# A domain registered fewer than this many days ago counts as "newly registered".
NEW_DOMAIN_DAYS=30

# --- Google AdSense (keep disabled until Google approves the publisher/site) ---
ADS_ENABLED=false
ADSENSE_APPROVED=false
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=

# --- Legacy payment-provider credentials ---
# PalmKash and Flutterwave are not available for new PhishGuard checkouts.
# Keep old transaction records for audit/history. Do not add their secrets here.
# New checkout remains disabled until the approved UrubutoPay integration is
# implemented, tested, and enabled with merchant credentials.
#
# --- Opening the app from a phone on the same Wi-Fi (local testing) ---
# 1) Uncomment the next line, 2) restart the app, 3) on the phone open
#    http://<this-computer-IP>:5000  (find the IP with "ipconfig" on Windows).
# 4) Over plain http the phone needs SESSION_COOKIE_SECURE=false, or your scan
#    history will not be remembered. Never use these two settings on the
#    public website (Render uses https and must keep SESSION_COOKIE_SECURE=true).
# PHISHGUARD_HOST=0.0.0.0
# PHISHGUARD_PORT=5000
# SESSION_COOKIE_SECURE=false

# --- Brevo transactional email (account verification and password reset) ---
# Create an SMTP key in Brevo. Keep the real values only in your local .env
# or your production host's environment variables. Never commit the real key.
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SENDER_NAME=PhishGuard Security
# Trusted public origin used to build links in emails.
# Local development: http://127.0.0.1:5000
# Production: https://your-real-domain.example
PUBLIC_APP_URL=

# Public support address shown on the legal policy pages.
# Configure a monitored address before launching publicly.
PUBLIC_SUPPORT_EMAIL=aldosergentwari@gmail.com

# Owner account email allowed to sign in at /admin. The account must exist and have a verified email.
# Create the account through the normal registration flow, verify its email, then set this value.
PHISHGUARD_OWNER_EMAIL=

# Optional absolute path for persistent SQLite storage on a deployment host.
# Example for a Render persistent disk mounted at /var/data:
# PHISHGUARD_DATABASE_PATH=/var/data/phishguard.db
# Leave blank for the local default database under backend/database/.
PHISHGUARD_DATABASE_PATH=
